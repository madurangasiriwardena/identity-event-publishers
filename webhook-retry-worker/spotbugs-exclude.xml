<FindBugsFilter>
    <!-- Worker parts receive shared collaborators (queue, HTTP client, metrics) through constructors on purpose. -->
    <Match>
        <Package name="org.wso2.identity.event.delivery.worker"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- Secret file paths come from environment variables set by the operator, not from request input. -->
    <Match>
        <Or>
            <Class name="org.wso2.identity.event.delivery.worker.Main"/>
            <Class name="~org\.wso2\.identity\.event\.delivery\.worker\.WorkerConfig.*"/>
        </Or>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
    <!-- The log formatter writes stack traces to the service log on purpose; logs never reach webhook endpoints. -->
    <Match>
        <Class name="org.wso2.identity.event.delivery.worker.LogSetup$LineFormatter"/>
        <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
    </Match>
</FindBugsFilter>
