<FindBugsFilter>
    <!-- Components receive shared collaborators (HTTP client, store, dispatcher, OSGi services) through their
         constructors and keep them on purpose. -->
    <Match>
        <Package name="~org\.wso2\.identity\.event\.websub\.direct\.publisher(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- OSGi data holder singleton, the usual Carbon pattern: it hands out the shared OSGi services. -->
    <Match>
        <Class name="org.wso2.identity.event.websub.direct.publisher.internal.component.WebSubDirectDataHolder"/>
        <Bug pattern="EI_EXPOSE_REP,MS_EXPOSE_REP"/>
    </Match>
    <!-- The key directory comes from the server's own configuration file, which only administrators can change. -->
    <Match>
        <Or>
            <Class name="org.wso2.identity.event.websub.direct.publisher.internal.component.WebSubDirectServiceComponent"/>
            <Class name="org.wso2.identity.event.websub.direct.publisher.config.WebSubDirectConfiguration"/>
        </Or>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
</FindBugsFilter>
